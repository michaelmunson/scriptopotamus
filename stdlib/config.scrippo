config(
  field... #? {field} to get, {field}={value} to set; any number of sets, one get
  [
    --init<str> #? initialize the config; a config id or a path ending in .json
    [--force] #? reset an existing config file to {}
    [-f / --default<str>...] #? {field} {value} pairs set only when the field is missing
  ]
  [--interactive] #? edit the selected config through a menu
  [
    --assign<str>... #? {field}:{VARIABLE}, set VARIABLE to the value of field
  ]
)
  _scrippo_config "$force" "$init" "$interactive" "${#f[@]}" "${#field[@]}" "${f[@]}" "${field[@]}" "${assign[@]}"
