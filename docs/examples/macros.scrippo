@import simple.scrippo

throw_error()
  @throw 1 "This is a bad function"

prt_msg()
  @prt -s red "I am colored red!"

input_fn()
  @input "Choose an option" --select "option1" "option2" "option3" --multi -v my_var
  @input --confirm "Are you sure you want to do this?" -v my_var
  @input "Enter a message" -v my_var

.sel()
  @input "Choose an option" --select "option1" "option2" "option3" --multi -v my_var
  for option in $my_var
    @prt "You chose:" -s green "$option"

.confirm()
  @input --confirm "Are you sure you want to do this?" -v my_var

.input()
  @input "Enter a message" -v my_var