@import scrippo/std
@import "./fs.scrippo" --as .fs
@import "./stdlib.scrippo" --as .stdlib
#? hello world function
.hello(
	name #? Name of the person to greet
)
	.world(@inherit [
		--age<int> #? Age of the person to greet
	])
		prt  -s green "Hello, $name!"
		if -n $age
			prt  -s yellow "You are $age years old."
	@usage 0

#? example: args --many a b c --required 1 hello world 123
.args(
	--required<int>
	[--optional]
	[--many<str>...]
	*rest
)
	prt "Required:" -s yellow $required
	prt "Optional:" -s yellow $optional
	prt "Many:" -s yellow "${many[@]}"
	prt "Rest:" -s yellow "${rest[@]}"

.dicts()
	mydict<dict>=(a=1 b=2 c=3)
	for i in ${!mydict[@]}
		prt "Key:" -s yellow $i
		prt "Value:" -s yellow $mydict[$i]

	-> $(dict --length mydict)