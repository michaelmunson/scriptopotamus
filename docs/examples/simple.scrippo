
PI<const float>=3.14

circumference(
  --diameter<float> | --radius<float>
)
  if -n $diameter
    -> $($PI * $diameter)
  elif -n $radius
    -> $($PI * $radius * 2)
  else
    @throw 1 "no diameter or radius provided"

-> "Circumference (diameter=2): $(circumference --diameter 2)"
-> "Circumference (radius=2): $(circumference --radius 2)"

case $1
  hello) -> "Hello!"
  goodbye) -> "Goodbye!"

