#? Compile .scrippo to bash and run it (a wrapper around scrippo-core)
.(
  #? Show this usage
  [-h / --help]
  #? Print the scrippo version
  [-V / --version]
  #? Compile to stdout instead of running
  [-c / --compile] |
  #? Compile, then syntax-check with bash -n
  [--noexec] |
  [
    [
      #? Create a package or script; <file> is its name
      -n / --new |
      [
        #? Install packages and scripts (or only one kind with -p / -s) from a Git repository or local directory; <file> is the source, [args] an optional directory inside it (default: its root) then an optional destination
        -i / --install
        #? Exact stable version tag to install (default: highest Git tag, or @info version for directories)
        [--tag<str>]
      ] |
      #? List packages or scripts
      -ls / --list |
      #? Remove a package or script; <file> is its name
      -rm / --remove
    ]
    [
      #? Select packages
      -p / --package |
      #? Select scripts
      -s / --script
    ]
    [
      #? Use ~/.scrippo, or SCRIPPO_HOME (default: project / current directory)
      -g / --global
    ]
  ] |
  #? Print settings, or set them; [args] are key=value pairs
  [--configure] |
  #? Emit the shell hook for autoload (eval from your shell rc)
  [--hook] |
  #? Emit aliases and completions for the current directory
  [--env] |
  #? Emit completion candidates for <file>; [args] are the words typed so far
  [--complete]
  #? Script to run (or a name in ~/.scrippo/scripts), or the value for the mode flags
  [file]
  #? Passed through to the script
  *args
)
  if $help
    if [[ -z $file ]]
      @usage 0
  if [[ $# -eq 0 ]]
    @usage
  core="${SCRIPPO_CORE:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/scrippo-core}"
  [[ -x $core ]] || core=scrippo-core
  exec "$core" "$@"
