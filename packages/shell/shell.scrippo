@info
  --name shell
  --version 0.6.6
  --description "Editable command input in the calling shell"
  --package

#? Queue editable input for the calling interactive shell. Requires scrippo-core --init.
shell(text)
  if [[ -z ${SCRIPPO_SHELL_INPUT-} || ! -f $SCRIPPO_SHELL_INPUT || ! -w $SCRIPPO_SHELL_INPUT ]]
    printf '%s\n' 'shell: enable shell integration with eval "$(scrippo-core --init)" first' >&2
    return 1
  printf '%s' "$text" > "$SCRIPPO_SHELL_INPUT"
