@import "ast.bash"
@import "macros.bash"
@import "macros/throw.bash"
@import "macros/prt.bash"
@import "macros/input.bash"
@import "macros/import.bash"
@import "compiler.bash"

scrippo(
  path
  [-c | --compile]
  [-n | --noexec]
  [-v | --verbose]
)
  echo "path: $path"
  echo "compile: $--compile"
  echo "noexec: $--noexec"
  echo "verbose: $--verbose"
  if $--noexec
    bash -n <(compile "$path")
  elif $--compile
    compile "$path"
  else
    bash -c "$(compile "$path")"

scrippo "$@"