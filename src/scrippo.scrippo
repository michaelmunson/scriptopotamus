# scrippo "$@"
.(
	[path]
	[-c | --compile]
	[-n | --noexec]
	[-v | --verbose]
	[--version]
	[*rest]
)
	if $--version
		-> $(jq -r '.version' <<< $(cat ./dev/vscode-ext/package.json))
	elif $--noexec
		bash -n <(compile "$path")
	elif $--compile
		compile "$path"
	else
		bash -c "$(compile "$path")" "$path" "${rest[@]}"

.configure(
	[--autoload<int(0 1)>]
	[--autocomplete<int(0 1)>]
)
	shell_configure "$autoload" "$autocomplete"

.__source()
	shell_source

.__aliases([dir])
	shell_aliases "${dir:-$PWD}"

.__complete([file] [*words])
	shell_complete "$file" "${words[@]}"

