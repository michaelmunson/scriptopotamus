@import "ast.bash"
@import "macros.bash"
@import "macros/throw.bash"
@import "macros/prt.bash"
@import "macros/input.bash"
@import "macros/import.bash"
@import "compiler.bash"

scrippo(
  [path]
  [-c | --compile]
  [-n | --noexec]
  [-v | --verbose]
  [--version]
  [*rest]
)
  if $--version
    -> $(jq -r '.version' <<< $(cat ./dev/vscode-ext/package.json))
  elif $--noexec
    bash -n <(compile "$path")
  elif $--compile
    compile "$path"
  else
    bash -c "$(compile "$path")" "$path" "${rest[@]}"

scrippo "$@"