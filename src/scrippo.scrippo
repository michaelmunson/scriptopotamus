SRC_DIR=$(dirname "${BASH_SOURCE[0]}")

source "$SRC_DIR/src/ast.bash"
source "$SRC_DIR/src/compiler.bash"

scrippo(
  path
  [-c | --compile]
  [-n | --noexec]
  [-v | --verbose]
)
  echo "path: $path"
  echo "compile: $--compile"
  echo "noexec: $--noexec"
  echo "verbose: $--verbose"
  if $--noexec
    bash -n <(compile "$path")
  elif $--compile
    compile "$path"
  else
    bash -c "$(compile "$path")"

scrippo "$@"
