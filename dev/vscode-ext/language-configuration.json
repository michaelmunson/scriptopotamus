{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_][\\w-]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|elif|while|case)\\s+\\S.*|else|for\\s+\\w+\\s+in\\s+\\S.*|(?:\\.|\\.?[A-Za-z_]\\w*)\\(.*\\)|[^\\s()#][^()]*\\)|\\))\\s*$",
    "decreaseIndentPattern": "^\\s*(?:elif\\b|else\\b|\\))"
  }
}
