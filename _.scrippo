#! /usr/bin/env scrippo
@import scrippo/std
.version(
	[version<str {patch minor major}>]
)
	current_version<str>=$(jq -r '.version' <<< $(cat ./dev/vscode-ext/package.json))
	version_parts<list>=()
	for part in ${current_version//./" "}
		version_parts+=($part)

	case $version
		patch)
			version_parts[2]=$((version_parts[2] + 1))
		minor)
			version_parts[1]=$($version_parts[1] + 1)
			version_parts[2]=0
		major)
			version_parts[0]=$($version_parts[0] + 1)
			version_parts[1]=0
			version_parts[2]=0
		*)


	new_version<str>="$version_parts[0].$version_parts[1].$version_parts[2]"

	jq -r '.version = "'"$new_version"'"' <<< $(cat ./dev/vscode-ext/package.json) > ./dev/vscode-ext/package.json.tmp

	mv ./dev/vscode-ext/package.json.tmp ./dev/vscode-ext/package.json

	-> $(jq -r '.version' <<< $(cat ./dev/vscode-ext/package.json))

.build()
	make build
	make install
	for f in ./*.vsix
		rm $f
		-> "removed $f"
	cd ./dev/vscode-ext
	npm run build
	mv ./*.vsix @rootdir/
